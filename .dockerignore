# зависимости и кэши
**/node_modules
**/.pnpm-store
**/.npm
**/.yarn
**/.cache

# фронтенд билды
**/.next
**/dist
**/build
**/out
**/.nuxt
**/.svelte-kit

# логи
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# тесты и покрытия
**/coverage
**/.nyc_output

# IDE / OS мусор
**/.DS_Store
**/Thumbs.db

# временные файлы
**/*.tmp
**/*.swp

# env (оставь только если реально не нужны в build)
.env*
!*.env.example

# docker override (часто не нужен в build)
docker-compose.override.yml

# архивы и бинарники
**/*.zip
**/*.tar
**/*.tar.gz
**/*.rar

# большие медиа (если случайно есть)
**/*.mp4
**/*.mov
**/*.avi

# тестовые данные / дампы
**/*.sql
**/*.sqlite
**/*.db